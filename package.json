{
  "name": "game-config-builder",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev:web": "pnpm --filter @gcb/web dev",
    "dev:server": "pnpm --filter @gcb/server dev",
    "test": "vitest run",
    "test:update-goldens": "node scripts/update-goldens.mjs",
    "test:e2e": "pnpm --filter @gcb/web test:e2e",
    "lint": "eslint . && prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "cli": "pnpm --filter @gcb/cli cli"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
